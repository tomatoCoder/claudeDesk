{
  "name": "claude-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "bridge:test": "vitest run --root bridge",
    "bridge:typecheck": "tsc -p bridge/tsconfig.json --noEmit",
    "bridge:build:dev": "tsc -p bridge/tsconfig.build.json",
    "bridge:catalog-exit:test": "pnpm bridge:build:dev && node --test scripts/bridge-catalog-exit.node-test.mjs",
    "bridge:sidecar:test": "node --test scripts/build-sidecar.node-test.mjs",
    "bridge:sidecar": "node scripts/build-sidecar.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle:mac": "node scripts/build-macos.mjs",
    "bundle:mac:intel": "tauri build --target x86_64-apple-darwin --bundles app,dmg --ci",
    "verify:mac-bundle": "node scripts/verify-macos-bundle.mjs",
    "bundle:windows": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^0.540.0",
    "markdown-it": "15.0.1",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "bun": "1.4.2",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.8.0"
}
