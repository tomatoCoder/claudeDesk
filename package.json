{
  "name": "claude-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm bridge:build:dev && pnpm electron:compile && node scripts/electron-dev.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev:renderer": "vite",
    "electron:dev:app": "pnpm bridge:build:dev && pnpm electron:compile && electron .",
    "test": "vitest run",
    "bridge:test": "vitest run --root bridge",
    "bridge:typecheck": "tsc -p bridge/tsconfig.json --noEmit",
    "bridge:build:dev": "tsc -p bridge/tsconfig.build.json",
    "bridge:catalog-exit:test": "pnpm bridge:build:dev && node --test scripts/bridge-catalog-exit.node-test.mjs",
    "build": "pnpm bridge:build:dev && pnpm electron:compile && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "bundle:mac": "node scripts/build-electron.mjs mac",
    "bundle:mac:intel": "node scripts/build-electron.mjs mac --x64",
    "bundle:windows": "node scripts/build-electron.mjs windows",
    "verify:bundle": "node scripts/verify-electron-bundle.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^0.540.0",
    "markdown-it": "15.0.1",
    "pinia": "4.0.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "bun": "1.4.2",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.8.0"
}
