{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../dist-electron",
    "types": ["node", "electron"]
  },
  "include": ["main/**/*.ts", "preload/**/*.cts", "shared/**/*.ts"]
}
